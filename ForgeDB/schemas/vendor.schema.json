{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-forge.dev/schemas/vendor.schema.json",
  "title": "ForgeDB Vendor Descriptor",
  "description": "JSON Schema for ForgeDB vendor descriptor YAML files.",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^forgedb(-vendor|-vendors)?/v[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "website": {
      "type": ["string", "null"]
    },
    "country": {
      "type": ["string", "null"]
    },
    "description": {
      "type": "string"
    },
    "logo": {
      "type": ["string", "null"]
    },
    "logo_url": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
