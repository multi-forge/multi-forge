[Unit]
Description=ForgeOS Portal & Telemetry Engine (Go + Chi Native)
After=forge-ap.service
Wants=forge-ap.service

[Service]
Type=simple
KillMode=process
Environment=PORT=8080
Environment=FORGEOS_BASE=/opt/forgeos
ExecStart=/usr/local/bin/forge-portal
Restart=always
RestartSec=3
StandardOutput=append:/var/log/forge-portal.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
