[Unit]
Description=ForgeHub Framebuffer Kiosk Bridge
After=systemd-user-sessions.service plymouth-quit-wait.service network.target forgehub.service
Conflicts=getty@tty1.service

[Service]
Type=simple
# Reserva e isola tty1: alterna para VT1, desliga cursor piscante, limpa terminal e desativa blanking
ExecStartPre=-/bin/sh -c 'chvt 1 && setterm -cursor off -blank 0 -powersave off > /dev/tty1 2>/dev/null || true'
ExecStart=/usr/bin/python3 /opt/forgehub/hardware/display/forge_kiosk.py
ExecStopPost=-/bin/sh -c 'setterm -cursor on -blank 10 > /dev/tty1 2>/dev/null || true'
Restart=always
RestartSec=5
StandardInput=null
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
OOMScoreAdjust=-500

[Install]
WantedBy=graphical.target multi-user.target

