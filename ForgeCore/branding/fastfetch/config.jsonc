{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/etc/fastfetch/forge-logo-vars.txt",
    "type": "file",
    "color": {
      "1": "light_red",
      "2": "yellow",
      "3": "cyan",
      "4": "light_blue",
      "5": "blue"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "color": {
      "keys": "light_cyan",
      "title": "yellow",
      "separator": "light_green"
    },
    "separator": " ➜ "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "display",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
